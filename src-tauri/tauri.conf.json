{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cerne Code",
  "version": "0.1.0",
  "identifier": "com.cerne.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cerne Code",
        "width": 1180,
        "height": 780,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
          "nsis": {
            "installMode": "perMachine",
            "languages": [
              "PortugueseBR",
              "English",
              "Spanish",
              "SpanishInternational",
              "SimpChinese",
              "TradChinese"
            ],
            "displayLanguageSelector": true
          }
        }
  }
}
