{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cerne Code",
  "version": "0.1.5",
  "identifier": "com.cerne.app",
  "build": {
    "beforeDevCommand": "npm run prepare:node-runtime && npm run dev",
    "devUrl": "http://localhost:14200",
    "beforeBuildCommand": "npm run prepare:node-runtime && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cerne Code",
        "width": 1180,
        "height": 780,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/context-mode/LICENSE": "context-mode/LICENSE",
      "resources/context-mode/CERNE-PROVENANCE.md": "context-mode/CERNE-PROVENANCE.md",
      "resources/context-economy-notices/": "context-economy-notices/",
      "resources/node-runtime/package.json": "node-runtime/package.json",
      "resources/node-runtime/html_to_pdf.js": "node-runtime/html_to_pdf.js",
      "resources/node-runtime/node_modules/": "node-runtime/node_modules/",
      "resources/node-runtime/LICENSE": "node-runtime/LICENSE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "PortugueseBR",
          "English",
          "Spanish",
          "SpanishInternational",
          "SimpChinese",
          "TradChinese"
        ],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "category": "DeveloperTool"
  }
}
